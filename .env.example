# Production environment variables (copy to `.env` for local runs).
# Replit injects these automatically in development and deployment.

# --- API server (artifacts/api-server) ---
# Required. PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Required. Port the API server listens on.
PORT=8080
# "production" enables JSON logs, HSTS, and hides internal error details.
NODE_ENV=production
# Optional. Pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Optional. Comma-separated browser origins allowed to call the API.
# Leave unset when the web app and API share an origin (the default deploy).
# CORS_ORIGINS=https://app.example.com
# Optional. Maximum PostgreSQL pool connections (default 10).
# DB_POOL_MAX=10

# --- Authentication ---
# Optional. Password-reset and sign-in email delivery (Resend HTTP API).
# Without it, reset links are written to the server log instead of sent, which
# is what local development and CI should use.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Override the provider endpoint (used by the automated suite to
# capture the reset link; leave unset in production).
# RESEND_ENDPOINT=https://api.resend.com/emails
# Optional. From address for reset email.
# EMAIL_FROM=Pocketful <onboarding@resend.dev>
# Optional. Origin the reset link points at. When unset, the link is built from
# the incoming request's own origin, so no hostname is hard-coded.
# WEB_APP_URL=https://app.example.com
# Optional. Lower scrypt cost. Only useful for fast automated runs; leaving it
# unset in production is what makes password hashes expensive to attack.
# PASSWORD_SCRYPT_N=32768

# --- Web app (artifacts/expense-manager) ---
# Required at build time. Port used for the dev and preview servers.
PORT=19111
# Required at build time. URL base path (use "/" at the domain root).
BASE_PATH=/
