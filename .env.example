# Production environment variables (copy to `.env` for local runs).
# Replit injects these automatically in development and deployment.

# --- API server (artifacts/api-server) ---
# Required. PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Required. Port the API server listens on.
PORT=8080
# "production" enables JSON logs, HSTS, and hides internal error details.
NODE_ENV=production
# Optional. Pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Optional. Comma-separated browser origins allowed to call the API.
# Leave unset when the web app and API share an origin (the default deploy).
# CORS_ORIGINS=https://app.example.com
# Optional. Maximum PostgreSQL pool connections (default 10).
# DB_POOL_MAX=10

# --- Web app (artifacts/expense-manager) ---
# Required at build time. Port used for the dev and preview servers.
PORT=19111
# Required at build time. URL base path (use "/" at the domain root).
BASE_PATH=/
