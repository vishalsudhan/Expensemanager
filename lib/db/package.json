{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "migrate:status": "node ./scripts/migrate.mjs status",
    "migrate:up": "node ./scripts/migrate.mjs up",
    "migrate:record": "node ./scripts/migrate.mjs record",
    "db:status": "node ./scripts/db-status.mjs",
    "apply:migration": "node ./scripts/apply-migration-0002.mjs",
    "push": "node ./scripts/guard-schema-push.mjs && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "node ./scripts/guard-schema-push.mjs --force && drizzle-kit push --force --config ./drizzle.config.ts",
    "seed": "test \"${NODE_ENV:-development}\" != production || { echo 'Refusing to seed production.' >&2; exit 1; }; test -n \"${DATABASE_URL:-}\" || { echo 'DATABASE_URL must be set.' >&2; exit 1; }; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
